<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0-browser</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser"/>
    <PackageReference Include="TextMateSharp.Wasm"/>

    <PackageVersion Update="Avalonia.Controls.ItemsRepeater" Version="12.0.0"/>
    <PackageVersion Update="Avalonia.Controls.DataGrid" Version="12.1.1"/>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Material.Avalonia.Demo\Material.Avalonia.Demo.csproj"/>
  </ItemGroup>

  <!--Since Material.Avalonia.DataGrid and TreeDataGrid are included as ProjectReferences, auto-imports doesn't work properly-->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MaterialThemeIncludeDataGrid" Value="true"/>
    <RuntimeHostConfigurationOption Include="MaterialThemeIncludeTreeDataGrid" Value="true"/>
    <TrimmerRootAssembly Include="Material.Avalonia.DataGrid"/>
    <TrimmerRootAssembly Include="Material.Avalonia.TreeDataGrid"/>
  </ItemGroup>
</Project>
