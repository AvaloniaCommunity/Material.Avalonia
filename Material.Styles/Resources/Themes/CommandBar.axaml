<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assists="clr-namespace:Material.Styles.Assists">
  <Design.PreviewWith>
    <Border Padding="20" Width="560">
      <CommandBar>
        <CommandBar.Content>
          <TextBlock Text="Document" VerticalAlignment="Center" Margin="8,0" />
        </CommandBar.Content>
        <CommandBar.PrimaryCommands>
          <CommandBarButton Label="New">
            <CommandBarButton.Icon>
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarButton Label="Save">
            <CommandBarButton.Icon>
              <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarSeparator />
          <CommandBarToggleButton Label="Bold">
            <CommandBarToggleButton.Icon>
              <PathIcon Data="M15.6,10.79C17.04,10.07 18,8.64 18,7C18,4.79 16.21,3 14,3H7V21H14.73C16.78,21 18.5,19.37 18.5,17.32C18.5,15.82 17.72,14.53 16.5,13.77C16.2,13.59 15.9,13.44 15.6,13.32V10.79M10,6.5H13C13.83,6.5 14.5,7.17 14.5,8C14.5,8.83 13.83,9.5 13,9.5H10V6.5M13.5,17.5H10V14H13.5C14.33,14 15,14.67 15,15.5C15,16.33 14.33,17.5 13.5,17.5Z" />
            </CommandBarToggleButton.Icon>
          </CommandBarToggleButton>
        </CommandBar.PrimaryCommands>
        <CommandBar.SecondaryCommands>
          <CommandBarButton Label="Print">
            <CommandBarButton.Icon>
              <PathIcon Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
        </CommandBar.SecondaryCommands>
      </CommandBar>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="MaterialCommandBarButton" TargetType="CommandBarButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="Width" Value="72" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Panel>
            <Border Name="PART_StateLayer"
                    Background="{DynamicResource MaterialBodyBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <StackPanel Name="PART_LayoutRoot"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <ContentPresenter Name="PART_IconPresenter"
                                Content="{TemplateBinding Icon}"
                                Foreground="{TemplateBinding Foreground}"
                                Width="24" Height="24"
                                HorizontalAlignment="Center" />
              <TextBlock Name="PART_Label"
                         Text="{TemplateBinding Label}"
                         Foreground="{TemplateBinding Foreground}"
                         FontSize="12"
                         FontWeight="Medium"
                         HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>

    <Style Selector="^[IsCompact=True]">
      <Setter Property="Width" Value="48" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="12" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="MaterialCommandBarToggleButton" TargetType="CommandBarToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="Width" Value="72" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Panel>
            <Border Name="PART_StateLayer"
                    Background="{DynamicResource MaterialBodyBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <StackPanel Name="PART_LayoutRoot"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <ContentPresenter Name="PART_IconPresenter"
                                Content="{TemplateBinding Icon}"
                                Foreground="{TemplateBinding Foreground}"
                                Width="24" Height="24"
                                HorizontalAlignment="Center" />
              <TextBlock Name="PART_Label"
                         Text="{TemplateBinding Label}"
                         Foreground="{TemplateBinding Foreground}"
                         FontSize="12"
                         FontWeight="Medium"
                         HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryMidBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryMidBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.20" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>

    <Style Selector="^[IsCompact=True]">
      <Setter Property="Width" Value="48" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="12" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="MaterialCommandBarSeparator" TargetType="CommandBarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource MaterialDividerBrush}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                MinHeight="{TemplateBinding MinHeight}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="8,4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="MaterialCommandBar" TargetType="CommandBar">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource MaterialToolBarBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="DefaultLabelPosition" Value="Collapsed" />
    <Setter Property="ItemWidthBottom" Value="72" />
    <Setter Property="ItemWidthRight" Value="102" />
    <Setter Property="ItemWidthCollapsed" Value="48" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                MinHeight="{TemplateBinding MinHeight}">
          <Panel>
            <DockPanel KeyboardNavigation.TabNavigation="Cycle">
              <Button Name="PART_OverflowButton"
                      DockPanel.Dock="Right"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      Foreground="{TemplateBinding Foreground}"
                      Padding="12"
                      Width="48" Height="48"
                      MinWidth="48" MinHeight="48"
                      CornerRadius="24"
                      VerticalAlignment="Center"
                      IsVisible="{TemplateBinding IsOverflowButtonVisible}">
                <PathIcon Width="24" Height="24"
                          Foreground="{TemplateBinding Foreground}"
                          Data="M6,10A2,2 0 0,0 4,12A2,2 0 0,0 6,14A2,2 0 0,0 8,12A2,2 0 0,0 6,10M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M18,10A2,2 0 0,0 16,12A2,2 0 0,0 18,14A2,2 0 0,0 20,12A2,2 0 0,0 18,10Z" />
              </Button>

              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center" />

              <ItemsControl Name="PART_PrimaryCommands"
                            ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>

            <Popup Name="PART_OverflowPopup"
                   IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding #PART_OverflowButton}"
                   Placement="Bottom"
                   IsLightDismissEnabled="True"
                   WindowManagerAddShadowHint="True">
              <Border Background="{DynamicResource MaterialCardBackgroundBrush}"
                      CornerRadius="4"
                      Padding="4"
                      MinWidth="160"
                      assists:ShadowAssist.ShadowDepth="Depth2">
                <ItemsControl Name="PART_OverflowPresenter"
                              ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CommandBarButton}" TargetType="CommandBarButton"
                BasedOn="{StaticResource MaterialCommandBarButton}" />
  <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton"
                BasedOn="{StaticResource MaterialCommandBarToggleButton}" />
  <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator"
                BasedOn="{StaticResource MaterialCommandBarSeparator}" />
  <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar"
                BasedOn="{StaticResource MaterialCommandBar}" />
</ResourceDictionary>