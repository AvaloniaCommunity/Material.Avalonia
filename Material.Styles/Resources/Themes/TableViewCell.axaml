<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Thickness x:Key="TableViewCellPadding">16,0</Thickness>

  <ControlTheme x:Key="MaterialTableViewCell" TargetType="TableViewCell">
    <Setter Property="Padding" Value="{DynamicResource TableViewCellPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewCell}"
                TargetType="TableViewCell"
                BasedOn="{StaticResource MaterialTableViewCell}" />
</ResourceDictionary>