<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="TableViewColumnResizerWidth">12</x:Double>

  <ControlTemplate x:Key="TableViewColumnHeaderResizerTemplate" TargetType="Thumb">
    <Border Background="Transparent">
      <Rectangle Width="1"
                 Fill="{DynamicResource MaterialDividerBrush}"
                 HorizontalAlignment="Center" />
    </Border>
  </ControlTemplate>

  <ControlTheme x:Key="MaterialTableViewColumnHeader" TargetType="TableViewColumnHeader">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialColumnHeaderBrush}" />
    <Setter Property="Padding" Value="{DynamicResource TableViewCellPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <Thumb Name="PART_Resizer"
                 Template="{StaticResource TableViewColumnHeaderResizerTemplate}"
                 Width="{DynamicResource TableViewColumnResizerWidth}"
                 HorizontalAlignment="Right"
                 Cursor="SizeWestEast"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
      <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}"
                TargetType="TableViewColumnHeader"
                BasedOn="{StaticResource MaterialTableViewColumnHeader}" />
</ResourceDictionary>